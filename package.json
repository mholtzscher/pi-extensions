{
  "name": "pi-extensions-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo of pi coding-agent extensions",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "ultracite check --type-aware",
    "fix": "ultracite fix --type-aware",
    "typecheck": "tsc --noEmit",
    "check:all": "npm run check && npm run typecheck",
    "pack:all": "for p in packages/*; do (cd \"$p\" && npm pack --dry-run); done"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@sinclair/typebox": "0.34.48",
    "@types/node": "^24.5.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.9.2",
    "ultracite": "^7.12.0"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
