{
  "name": "@mholtzscher/pi-extensions",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo of pi coding-agent extensions",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "pack:all": "for p in packages/*; do (cd \"$p\" && npm pack --dry-run); done"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@sinclair/typebox": "0.34.48",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
